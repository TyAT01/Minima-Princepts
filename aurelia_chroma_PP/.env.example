# Aurelia Vale Configuration Example
# Rename this file to .env and fill in your values

# Discord Bot Token (from Discord Developer Portal)
AURELIA_VALE_DISCORD_TOKEN=your_token_here

# The ID of the Discord Server
AURELIA_VALE_DISCORD_GUILD_ID=123456789012345678

# The ID of the Voice Channel Aurelia should join
AURELIA_VALE_DISCORD_VOICE_CHANNEL_ID=123456789012345678

# Optional: Model settings
# AURELIA_VALE_CHROMA_MODEL_ID=FlashLabs/Chroma-4B
# AURELIA_VALE_MAX_NEW_TOKENS=100
