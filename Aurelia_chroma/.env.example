# Aurelia Chroma Configuration Example
# Rename this file to .env and fill in your values

# Discord Bot Token (from Discord Developer Portal)
AURELIA_CHROMA_DISCORD_TOKEN=your_token_here

# The ID of the Discord Server
AURELIA_CHROMA_DISCORD_GUILD_ID=123456789012345678

# The ID of the Voice Channel Aurelia should join
AURELIA_CHROMA_DISCORD_VOICE_CHANNEL_ID=123456789012345678

# Optional: Model settings
# AURELIA_CHROMA_CHROMA_MODEL_ID=FlashLabs/Chroma-4B
# AURELIA_CHROMA_MAX_NEW_TOKENS=100
